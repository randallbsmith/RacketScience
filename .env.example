# Requires Node.js 22+. Local sign-in uses a Google OAuth web client.
PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
DATA_DIR=./data
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Sender must be verified with Resend; no emails are sent without --send.
RESEND_API_KEY=
EMAIL_FROM=
# Leave off until hosting, authentication and email are configured and tested.
SCHEDULES_ENABLED=false
